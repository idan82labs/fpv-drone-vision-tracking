# Copy to /etc/fpv-tracker.env on the Raspberry Pi and edit paths/device.
FPV_REPO=/opt/fpv-drone-vision-tracking
FPV_VIDEO_SOURCE=camera:0
FPV_OUTPUT_DIR=/run/fpv-tracker/latest
FPV_PROFILE=pi_light_live
FPV_MAX_FRAMES=
FPV_SELECTED_JSONL=/run/fpv-tracker/selected.jsonl
FPV_TELEMETRY_JSONL=/run/fpv-tracker/telemetry.jsonl
